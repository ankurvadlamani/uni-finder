rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in user can only read and write their own data.
// The deadline agent uses the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{coll}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && coll in ['programs', 'alerts', 'sops'];
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
